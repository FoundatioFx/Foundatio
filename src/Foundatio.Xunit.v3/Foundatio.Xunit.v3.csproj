<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>xUnit v3 test utilities for Foundatio including test logging. For projects still on xUnit v2, use Foundatio.Xunit instead.</Description>
    <PackageTags>$(PackageTags);Logging;Log;Xunit;Retry</PackageTags>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>Foundatio.Xunit</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Foundatio\Foundatio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.assert" Version="4.0.3" />
    <PackageReference Include="xunit.v3.extensibility.core" Version="4.0.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
  </ItemGroup>
</Project>
