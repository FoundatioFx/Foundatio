<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <MassTransitVersion Condition="'$(MassTransitVersion)' == ''">8.5.10</MassTransitVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Foundatio/Foundatio.csproj" />
    <ProjectReference Include="../../src/Foundatio.Redis/Foundatio.Redis.csproj" />
    <ProjectReference Include="../../src/Foundatio.Aws/Foundatio.Aws.csproj" />
    <PackageReference Include="MassTransit.AmazonSQS" Version="$(MassTransitVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
  </ItemGroup>
</Project>
